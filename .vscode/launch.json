{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080", // Ensure this matches your server's URL
            "webRoot": "${workspaceFolder}", // Ensure this points to your project's root
            "sourceMaps": true, // Enable source maps
            "skipFiles": ["chrome-error://*"] // Skip debugging Chrome error pages
        }
    ]
}